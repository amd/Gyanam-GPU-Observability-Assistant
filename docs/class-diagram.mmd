---
title: GYANAM — GPU Observability Assistant — Class Relationships
---
%% Source of truth: this .mmd file.
%% Rendered PDF (docs/class-diagram.pdf) is regenerated separately —
%% see scripts/README.md "Regenerating diagrams".
classDiagram
    direction LR

    %% ============ COLLECTION LAYER (Blue) ============
    namespace Collection {
        class RedfishPoller {
            +start()
            +stop()
            +poll_single(target_id)
            +get_results() list
            +get_stats() dict
            -_schedule_due_polls()
            -_run_poll(target)
            -_status_writer_loop()
            -_flush_pending_status()
            -_get_client(target) RedfishClient
            -_close_client(target_id)
            -_clients: dict[int, RedfishClient]
            -_inflight: dict[int, Task]
            -_pending_status: dict[int, tuple]
            -_next_poll_time: dict[int, datetime]
            -_semaphore: Semaphore (max_concurrent=100)
        }

        class SSEManager {
            +start()
            +stop()
            +active_connections int
        }

        class SSEConnection {
            +start(queue)
            +stop()
        }

        class RedfishClient {
            +connect()
            +collect_diagnostic_data()
            +discover_collect_endpoint() str
            +get_metric_report(uri)
            +test_connection() tuple
            -_http_get / _http_post / _http_delete
        }

        class ShardManager {
            +balance: static | dynamic(HRW)
            +claim_once() int
            +run()
            +release()
            +owned_count int
            -collector_id: str
            -config: ShardConfig
        }

    }

    %% ============ ALERTING LAYER (Pink) ============
    namespace Alerting {
        class AlertManager {
            +start()
            +stop()
            +process_webhook_event(target_id, payload)
            +get_stats() dict
            -_refresh_subscriptions_loop()
            -_batch_processor_loop()
            -_cleanup_loop()
            -_baseline_repull_loop()
            -_on_alert(event)
            -_cper_worker: CperEnrichmentWorker
            -_permanently_failed: dict[int, datetime]
        }

        class RateLimiter {
            +allow(target_id) bool
            -max_alerts_per_minute: int
        }

        class AlertSubscriber {
            +start()
            +stop()
            +state: SubscriptionState
            +consecutive_failures: int
        }

        class WebhookSubscriber {
            +create_subscription() SubscriptionResult
            +delete_subscription()
            +parse_webhook_event(data) list
        }

        class AlertEvent {
            +target_id, severity
            +message, event_type
            +event_timestamp
        }

        class CperEnrichmentWorker {
            +start()
            +stop()
            +stats() dict
            -_loop()
            -_refresh_backlog(counts)
            -cper_convert_path: str
        }

        class CperDecoder {
            <<cper_decoder module>>
            +fetch_cper_attachment() bytes
            +decode_cper() dict
            +enrich_amd_sections(decoded) dict
            +summarize_cper(decoded) str
        }
    }

    %% ============ PROCESSING LAYER (Green) ============
    namespace Processing {
        class MetricExtractor {
            +extract_from_data(data) list
        }

        class MetricDiscovery {
            +discover(data) list
        }

        class BlobUnpacker {
            +unpack(content) list
            +cleanup(files)
        }

        class SchemaLoader {
            +load()
            +get_schemas() list
        }

        class RedfishLogParser {
            +parse_file(path) list
        }
    }

    %% ============ EXPORT LAYER (Purple) ============
    namespace Export {
        class BaseExporter {
            <<abstract>>
            +write(metrics) bool
            +health_check() tuple
            +is_connected bool
        }

        class InfluxDBExporter {
            +write(metrics) bool
            +buffer_size int
            +get_health_metrics() dict
            -_flush_loop()
            -_flush_buffer()
            -_reconnect() bool
            -_force_reset_connection()
            -_flush_event: Event
            -_consecutive_batch_failures: int
            -_reconnect_count: int
        }
    }

    %% ============ DIGITAL TWIN / DATA HALL LAYER (Teal) ============
    namespace Twin {
        class DataHallView {
            <<datahall routes>>
            +datahall_layout() dict
            +datahall_heatmap(metric) dict
            +set_placement(target_id)
            +resolve_placements()
            -_build_layout(systems) dict
            -_inventory_tooltip(target) dict
        }

        class InventoryEnricher {
            +run()
            -_needs_discovery(target) bool
            -_discover_reports(target)
            -repository, inv_config, location_config
        }

        class Inventory {
            +gpu_count, gpu_model
            +gpu_memory_gib, firmware
            +height_u
            +has_data() bool
            +derive_height_u()
            +tooltip() dict
        }

        class Placement {
            +hall, row, rack
            +unit, source
            +has_location() bool
            +to_columns() dict
            +from_target(target) Placement
        }

        class LocationResolver {
            <<location module>>
            +parse_hostname(host) Placement
            +parse_system_location(...) Placement
            +placement_from_location(loc) Placement
            +should_overwrite(old, new) bool
        }

        class HeatmapCache {
            <<singleton HEATMAP>>
            +record(host, name, value)
            +latest(metric) dict
        }
    }

    %% ============ DATA LAYER (Orange) ============
    namespace Data {
        class TargetRepository {
            +create_target()
            +get_all_targets()
            +get_active_targets() list
            +claim_shard_targets(cid, cap, ttl) int
            +get_owned_targets(cid, ttl) list
            +release_shard_leases(cid)
            +upsert_collector_stats(cid, data, owned)
            +get_collector_stats(max_age) list
            +upsert_heatmap_snapshot(metric, values, cid)
            +get_heatmap_snapshot(metric) dict
            +update_poll_status_batch(updates)
            +create_alerts_batch(alerts) int
            +engine : SQLite (targets/logs/shards)
            +alert_engine : PostgreSQL (alerts)
        }

        class Target {
            +name, host, port
            +connection_mode
            +verify_ssl
            +consecutive_failures
        }

        class CollectedLog {
            +target_id, filename
            +file_path, status
            +file_size_bytes
        }

        class Alert {
            +target_id, severity
            +message, event_type
            +received_at
        }

        class LogCollector {
            +collect_single(target_id) dict
            +collect_all() dict
            -_collect_via_redfish(target) : rediscovers endpoint on 404
        }

        class ShardLease {
            +target_id, collector_id
            +updated_at
        }

        class CollectorStats {
            +collector_id, data
            +owned_targets, updated_at
        }

        class CollectorSlot {
            +ordinal, token
            +updated_at
        }

        class HeatmapSnapshot {
            +collector_id, metric
            +values (JSON), updated_at
        }
    }

    %% ============ DATA OBJECTS (Gray) ============
    namespace DataObjects {
        class Metric {
            +name, value, timestamp
            +tags, unit, metric_type
        }

        class PollResult {
            +target_id, success
            +content, data
            +collection_method
            +duration_ms
        }
    }

    %% ============ RELATIONSHIPS ============

    %% Collection caches (NOT creates) RedfishClient per target
    RedfishPoller --> RedfishClient : caches per target

    %% SSE
    SSEManager --> SSEConnection : manages 0..*

    %% Data flow: Collection → Processing → Export
    RedfishPoller ..> PollResult : produces
    SSEConnection ..> PollResult : produces

    PollResult ..> BlobUnpacker : blob content
    PollResult ..> MetricExtractor : JSON data
    BlobUnpacker ..> MetricExtractor : extracted files
    BlobUnpacker ..> RedfishLogParser : log files

    MetricExtractor --> SchemaLoader : uses schemas
    MetricDiscovery --> SchemaLoader : uses schemas
    MetricExtractor ..> Metric : produces
    MetricDiscovery ..> Metric : produces

    Metric ..> BaseExporter : written to
    BaseExporter <|-- InfluxDBExporter

    %% Alerting flow
    AlertManager --> AlertSubscriber : manages SSE 0..*
    AlertManager --> WebhookSubscriber : manages webhook 0..*
    AlertManager --> RateLimiter : per-target throttle
    AlertSubscriber ..> AlertEvent : produces
    WebhookSubscriber ..> AlertEvent : produces
    AlertEvent ..> TargetRepository : batched persist via create_alerts_batch
    AlertManager --> CperEnrichmentWorker : owns (enrichment)
    CperEnrichmentWorker ..> CperDecoder : uses
    CperEnrichmentWorker ..> TargetRepository : reads + updates alerts

    %% Digital twin / Data Hall: enrich inventory + placement, snapshot heatmap, serve 3D scene
    InventoryEnricher ..> RedfishClient : inventory walk (collect_inventory)
    InventoryEnricher ..> LocationResolver : resolve placement
    InventoryEnricher ..> Inventory : produces
    LocationResolver ..> Placement : produces
    InventoryEnricher --> TargetRepository : set_target_inventory + set_target_location
    InfluxDBExporter ..> HeatmapCache : records live values
    HeatmapCache ..> TargetRepository : snapshotted per collector (heatmap_snapshot_task)
    DataHallView ..> TargetRepository : reads targets + placement + merged HeatmapSnapshot
    DataHallView ..> Inventory : tooltip fields
    Placement ..> Target : stored in placement columns
    Inventory ..> Target : stored in inventory_json

    %% Sharding: ShardManager reconciles leases (dynamic HRW / static greedy);
    %% poller reads owned targets; stable id via slot claim in dynamic mode
    ShardManager --> TargetRepository : reconcile / heartbeat / reclaim leases
    TargetRepository --> ShardLease : manages
    TargetRepository --> CollectorStats : manages
    TargetRepository --> CollectorSlot : manages (stable ordinal)
    LogCollector ..> RedfishClient : discover_collect_endpoint on 404

    %% Data layer
    RedfishPoller --> TargetRepository : reads owned targets + batched status writes
    SSEManager --> TargetRepository : reads SSE targets
    AlertManager --> TargetRepository : reads alert-subscription config
    LogCollector --> TargetRepository : reads targets / writes CollectedLog
    LogCollector --> RedfishClient : reuses cached or builds new
    TargetRepository --> Target : manages
    TargetRepository --> CollectedLog : manages
    TargetRepository --> Alert : manages (PostgreSQL / alert_engine)

