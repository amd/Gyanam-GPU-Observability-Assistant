# GPU Metrics Collector - Environment Configuration
# Copy this file to .env and update with your values
# Run ./gyanam.sh init to generate secrets automatically

# InfluxDB Configuration
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=your-influxdb-password-here
INFLUXDB_ORG=prometheus
INFLUXDB_BUCKET=gpu_metrics

# Retention policies for tiered storage
INFLUXDB_RETENTION=7d                 # Raw data retention (5-min intervals)
INFLUXDB_15M_RETENTION=30d            # 15-minute aggregations retention
INFLUXDB_HOURLY_RETENTION=90d         # Hourly aggregations retention

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# Collector Configuration
ENCRYPTION_KEY=your-encryption-key-here

# Horizontal sharding (multi-collector). The shipped docker-compose enables this
# and runs 3 collector replicas (deploy.replicas), sized for fleets up to ~500
# targets at the 200/replica cap below (3 x 200 = 600 capacity). Scale the replica
# count to your fleet with `docker compose up -d --scale collector=N`, keeping
# N x MAX_TARGETS_PER_SHARD >= your enabled-target count. Small fleets can set
# COLLECTOR_SHARDING=false (or --scale collector=1); one collector owns everything.
COLLECTOR_SHARDING=true
MAX_TARGETS_PER_SHARD=200             # per-replica ownership cap (0 = config.yaml default)
# Balancing: "dynamic" (Rendezvous/HRW — even ±1 load, self-rebalancing; default)
# or "static" (greedy id-order, fallback). In dynamic mode replicas self-assign a
# stable collector-<n> id, so COLLECTOR_ID need not be set under --scale.
COLLECTOR_BALANCE=dynamic

# Alert System Configuration
# Webhook fallback needs a URL that every BMC can reach. The collector does not
# publish its webhook port by default, and webhook requests are not authenticated.
# Expose the receiver only on a trusted, restricted network.
#ALERT_WEBHOOK_BASE_URL=http://collector:8081/redfish-webhook
#ALERT_ENABLE_WEBHOOK_FALLBACK=true

# PostgreSQL alert store (high-volume Redfish alert/event history)
# NOTE: keep the password URL-safe (avoid @ : / # %) — it is embedded in
# ALERTS_DATABASE_URL by docker-compose.
POSTGRES_USER=gyanam
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=gyanam_alerts

# Build behind a TLS-intercepting corporate proxy: set to 1 to relax TLS cert
# verification during image builds — applies to BOTH the libcper git clone and
# the pip/PyPI install. Empty = full TLS verification (default).
PIP_TRUSTED_HOST=

# Metrics Backend: "influxdb" (default) or "prometheus"
METRICS_BACKEND=influxdb

# Port Configuration (change for multiple deployments on same host)
API_PORT=8080
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
